{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm --filter @workspace/loan-marketplace build && pnpm --filter @workspace/api-server build",
  "installCommand": "pnpm install",
  "outputDirectory": "artifacts/loan-marketplace/dist/public",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index.mjs"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}